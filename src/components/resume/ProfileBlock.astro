---
import { existsSync } from "node:fs";
import path from "node:path";
import type { CollectionEntry } from "astro:content";
import { withBase } from "../../lib/url";

type Profile = CollectionEntry<"resumes">["data"]["profile"];

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const alt = profile.avatarAlt ?? profile.name;

const avatarExtensions = ["jpg", "jpeg", "png", "webp", "svg"] as const;
const avatarExt =
  avatarExtensions.find((ext) =>
    existsSync(
      path.join(
        process.cwd(),
        "public",
        "images",
        "resumes",
        `${profile.avatar}.${ext}`,
      ),
    ),
  ) ?? "svg";
---

<div class="resume-profile flex flex-col items-center gap-4 text-center">
  <img
    src={withBase(`/images/resumes/${profile.avatar}.${avatarExt}`)}
    alt={alt}
    width="160"
    height="160"
    class="border-surface-card h-32 w-32 rounded-full border-4 object-cover shadow-md"
  />
  <div>
    <h1 class="font-heading text-2xl leading-tight font-semibold text-white">
      {profile.name}
    </h1>
    {
      profile.tagline && (
        <p class="mt-2 text-sm leading-snug text-white/80">{profile.tagline}</p>
      )
    }
    {
      profile.location && (
        <p class="mt-2 text-xs tracking-wider text-white/60 uppercase">
          {profile.location}
        </p>
      )
    }
  </div>
</div>
